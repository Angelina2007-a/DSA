class LinkedList{
	
	class Node{
		int data;
		Node next;
		
		Node(int data){
			this.data=data;
			this.next = null;
		}
	}
	Node head;
	
	void add(int data) {
		Node newnode = new Node(data);
		
		if(head==null) {
			head = newnode;
			return;
		}
		Node current = head;
		
		while(current.next != null) {
			current = current.next;
		}
		current.next=newnode;
		
	}
	
	void display() {
		Node current = head;
		while(current != null) {
			System.out.print(current.data+" -> ");
			current = current.next;
		}
		System.out.print("Null");		
		
	}
	public static void main(String args[]) {
		LinkedList list = new LinkedList();
		
		list.add(10);
		list.add(20);
		list.add(30);
		
		list.display();	
	}
}
